{
  "name": "llm-sidebar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI sidebar for Chrome and Firefox with your own API key and your choice of provider (OpenAI, Claude, Gemini, Grok, OpenRouter, Ollama …).",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dev": "node dev/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "llm",
    "ai",
    "sidebar",
    "openai",
    "claude",
    "gemini",
    "ollama",
    "translation"
  ]
}
